<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Niveau 1 : toutes les API utilisees (ListTemplate, GridTemplate,
            ConstraintManager, CarAppExtender) existent depuis cette version.
            Declarer plus haut excluait sans contrepartie les autoradios plus
            anciens, alors que le Desktop Head Unit, lui, tourne toujours au
            dernier niveau et ne revelait donc jamais le probleme.
        -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <service
            android:name="fr.maxboudier.poulpifyauto.car.PoulpifyCarAppService"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <!--
                    Categorie IOT : Poulpify n'est pas une app de navigation ni
                    un lecteur autonome, c'est un tableau de bord de session.
                    Acceptable en sideload ; un depot sur le Play Store
                    demanderait une categorie approuvee par Google.
                -->
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>
    </application>

</manifest>
