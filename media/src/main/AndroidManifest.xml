<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application>
        <!--
            Les deux actions sont necessaires : la premiere pour les clients
            media3, la seconde pour Android Auto qui passe encore par l'API
            MediaBrowserService historique pour decouvrir les apps media.
        -->
        <service
            android:name="fr.maxboudier.poulpifyauto.media.PoulpifyMediaLibraryService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>

</manifest>
